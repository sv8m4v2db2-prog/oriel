{
  "name": "@oriel/mcp",
  "version": "0.1.0",
  "private": true,
  "description": "Serveur MCP d’Oriel : permet à Claude (Desktop, Code, claude.ai) d'utiliser un espace Oriel via un jeton d'API personnel.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "bin": {
    "oriel-mcp": "dist/oriel-mcp.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node build.mjs",
    "start": "node dist/oriel-mcp.mjs",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --test --import tsx test/*.test.ts"
  },
  "dependencies": {
    "@oriel/shared": "0.1.0",
    "@blocknote/core": "0.55.0",
    "@blocknote/server-util": "0.55.0",
    "@blocknote/xl-multi-column": "0.55.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "esbuild": "0.28.2",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
