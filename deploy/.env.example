# Configuration d’Oriel pour docker compose — copiez ce fichier en « .env » :
#   cp .env.example .env
# (deploy/install.sh le crée pour vous.) Après modification : docker compose up -d

# --- Obligatoire -------------------------------------------------------------------------------

# Nom de domaine de votre instance. Un enregistrement DNS A (et AAAA si IPv6) doit pointer vers
# l'adresse IP de ce serveur avant le premier démarrage, pour que Caddy obtienne le certificat.
DOMAIN=notes.example.com

# Adresse e-mail transmise à Let's Encrypt (avertissements d'expiration de certificat).
ACME_EMAIL=admin@example.com

# --- Oriel ----------------------------------------------------------------------------------

# URL publique : sert aux liens d'invitation absolus et active les cookies « Secure ».
PUBLIC_URL=https://${DOMAIN}

# Mode d'inscription initial (modifiable ensuite par l'administrateur dans Réglages › Instance) :
#   first-user : seul le premier compte s'inscrit librement (il devient administrateur),
#                ensuite uniquement sur invitation  [par défaut]
#   invite     : uniquement sur invitation (sauf le premier compte)
#   open       : inscription libre
SIGNUP_MODE=first-user

# Taille maximale d'un fichier envoyé, en mégaoctets.
MAX_UPLOAD_MB=25

# Niveau de journalisation : fatal, error, warn, info, debug, trace.
LOG_LEVEL=info

# --- E-mails (facultatif) ----------------------------------------------------------------------
# Sans configuration SMTP, Oriel fonctionne normalement : pas d'e-mails, les liens (invitation,
# réinitialisation de mot de passe) sont affichés aux administrateurs pour être copiés.
# Soit une URL complète (smtp:// en STARTTLS sur 587, smtps:// en TLS sur 465) :
#SMTP_URL=smtps://utilisateur:motdepasse@smtp.example.com:465
# … soit les paramètres séparés :
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=utilisateur
#SMTP_PASS=motdepasse
#SMTP_SECURE=false
# Expéditeur des e-mails (défaut : Oriel <no-reply@<domaine de PUBLIC_URL>>).
#MAIL_FROM=Oriel <oriel@example.com>
