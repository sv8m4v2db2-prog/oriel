# Oriel derrière Nginx (alternative à Caddy), par exemple avec deploy/oriel.service
# (Oriel sur 127.0.0.1:3000) ou avec le conteneur publié uniquement en local.
#
#   sudo cp deploy/nginx.conf.example /etc/nginx/sites-available/oriel
#   (remplacer notes.example.com, obtenir le certificat : sudo certbot --nginx -d notes.example.com)
#   sudo ln -s /etc/nginx/sites-available/oriel /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# Points importants :
#   • /collab (édition collaborative) et /api/events (invalidations temps réel) sont des WebSockets :
#     en-têtes Upgrade/Connection obligatoires et délais longs ;
#   • client_max_body_size doit être ≥ MAX_UPLOAD_MB (25 Mo par défaut) ;
#   • X-Forwarded-Proto permet au serveur de poser des cookies « Secure » (TRUST_PROXY=true : Nginx
#     sur la même machine ou un réseau privé ; sinon TRUST_PROXY=<adresse IP de Nginx>).

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream oriel {
    server 127.0.0.1:3000;
    keepalive 16;
}

server {
    listen 80;
    listen [::]:80;
    server_name notes.example.com;

    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    # Nginx ≥ 1.25.1 : préférez « listen 443 ssl; » + « http2 on; ».
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name notes.example.com;

    ssl_certificate     /etc/letsencrypt/live/notes.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/notes.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:oriel_ssl:10m;

    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size 30m;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;

    # Chaque « location » redéclare ses proxy_set_header : Nginx n'hérite pas de ceux du
    # niveau « server » dès qu'une location en définit un.

    # WebSocket — édition collaborative (Yjs / Hocuspocus).
    location /collab {
        proxy_pass http://oriel;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;
    }

    # WebSocket — invalidations temps réel.
    location = /api/events {
        proxy_pass http://oriel;
        proxy_http_version 1.1;
        proxy_set_header Upgrade    $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
        proxy_buffering off;
    }

    # API et client web.
    location / {
        proxy_pass http://oriel;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }
}
